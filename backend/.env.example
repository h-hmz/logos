# Copy to .env and fill in your values. .env is gitignored.
# Full reference: see the "Environment Variables" table in README.md.

# ── LLM provider (any OpenAI-compatible endpoint) ───────────────────────────
# Both LLM and TTS calls go through the same OpenAI-compatible API.
# OpenRouter is the recommended default because of its prepaid hard
# spend cap (see ADR 0007), but the implementation works with any
# OpenAI-compatible provider (OpenAI, Together AI, Groq, Azure OpenAI,
# vLLM, Ollama, LM Studio, etc.).
LLM_API_KEY="sk-or-v1-..."

# Optional: override the OpenAI-compatible base URL.
# Defaults to https://openrouter.ai/api/v1
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="https://api.together.xyz/v1"
# LLM_BASE_URL="http://localhost:11434/v1"   # Ollama

# ── Model ───────────────────────────────────────────────────────────────────
# Use the provider's model identifier. OpenRouter's "provider/model"
# form works through the default base URL.
MODEL="google/gemini-3-flash-preview"

# ── Text-to-speech (optional) ───────────────────────────────────────────────
# TTS_ENABLED=TRUE
# TTS_MODEL="google/gemini-3.1-flash-tts-preview"

# ── Auth + storage (optional GCP services; LLM/TTS no longer use GCP) ──────
# The project this backend runs in — used for Firestore + Cloud Logging trace links.
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# The project that issues the Firebase ID tokens (the one your frontend signs in
# against). Required when AUTH_BACKEND=firebase. May equal GOOGLE_CLOUD_PROJECT
# (single project) or differ from it when Hosting/Auth live in a separate
# project — e.g. a free Spark-plan project — than the backend's Cloud Run + Firestore.
# FIREBASE_PROJECT="your-firebase-project-id"
# AUTH_BACKEND="firebase"          # or "none" for local dev
# Comma-separated emails and/or domains permitted past auth. A bare domain
# ("example.com") admits every verified address at that domain; a full address
# ("alice@other.com") admits just that user. Empty/unset denies everyone
# (fail-closed). Use "*" to allow all verified callers (local dev only).
# AUTH_ALLOWLIST="example.com,alice@other.com"
# STORAGE_BACKEND="memory"         # or "firestore"
# FIRESTORE_DATABASE="(default)"
# FIRESTORE_COLLECTION="debates"

# ── Optional server overrides ───────────────────────────────────────────────
# PORT="8000"
# DATA_DIR="./agents"

# ── Telemetry (optional; OTel metrics push to Grafana Cloud / any OTLP backend) ──
# When OTEL_EXPORTER_OTLP_ENDPOINT is empty (default), the SDK is a no-op and
# the backend logs "telemetry disabled". Set both to enable.
# Grafana Cloud portal: My Account → Details (Stack) → OpenTelemetry → Configure.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<base64 of instance_id:token>"
