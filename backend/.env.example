# Copy to .env and fill in your values.
# .env is gitignored.

# Option 1: Vertex AI (recommended — set your GCP project)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Option 2: Gemini API key (comment out Option 1 and uncomment below)
# GOOGLE_API_KEY="your-api-key"

# Optional overrides
# PORT="8000"
# DATA_DIR="./agents"

# Text-to-speech (Gemini 2.5 TTS)
# TTS_ENABLED=TRUE
# TTS_MODEL="gemini-2.5-flash-preview-tts"
# TTS uses the Gemini API backend only (Vertex does not serve TTS preview models).
# Required when the debate app runs on Vertex AI:
# TTS_API_KEY="your-gemini-api-key"
