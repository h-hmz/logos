# Copy to .env and fill in your values. .env is gitignored.
# Full reference: see the "Environment Variables" table in README.md.

# ── Main app: pick ONE backend ──────────────────────────────────────────────

# Option A — Vertex AI (recommended; uses ADC from `gcloud auth ...`)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Option B — Gemini API key (comment out Option A)
# GOOGLE_API_KEY="your-gemini-api-key"

# ── Text-to-speech (optional) ───────────────────────────────────────────────
# TTS_ENABLED=TRUE
# TTS_PROVIDER="gemini"                      # gemini | openai | mistral | elevenlabs
# TTS_MODEL="gemini-2.5-pro-preview-tts"     # provider-specific; blank = provider default
#
# Gemini: TTS runs on the Gemini API backend only (Vertex does not serve
# preview TTS). If the main app runs on Vertex, set a TTS-specific key here:
# TTS_API_KEY="your-gemini-api-key"
# (If unset, TTS falls back to GOOGLE_API_KEY.)
#
# OpenAI: set TTS_PROVIDER=openai (model defaults to gpt-4o-mini-tts).
# Genuinely streams — first audio in under a second.
# OPENAI_API_KEY="your-openai-api-key"
#
# ElevenLabs: set TTS_PROVIDER=elevenlabs (model defaults to eleven_flash_v2_5).
# Streams with ~400 ms time-to-first-audio. Free tier: 10k chars/month, no card.
# ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# ── Optional server overrides ───────────────────────────────────────────────
# PORT="8000"
# DATA_DIR="./agents"
