# Copy to .env and fill in your values.
# .env is gitignored.

# Option 1: Vertex AI (recommended — set your GCP project)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Option 2: Gemini API key (comment out Option 1 and uncomment below)
# GOOGLE_API_KEY="your-api-key"

# Optional overrides
# PORT="8000"
# DATA_DIR="./agents"
