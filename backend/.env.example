# Copy to .env and fill in your values. .env is gitignored.
# Full reference: see the "Environment Variables" table in README.md.

# ── LLM provider (any OpenAI-compatible endpoint) ───────────────────────────
# Both LLM and TTS calls go through the same OpenAI-compatible API.
# OpenRouter is the recommended default because of its prepaid hard
# spend cap (see ADR 0007), but the implementation works with any
# OpenAI-compatible provider (OpenAI, Together AI, Groq, Azure OpenAI,
# vLLM, Ollama, LM Studio, etc.).
LLM_API_KEY="sk-or-v1-..."

# Optional: override the OpenAI-compatible base URL.
# Defaults to https://openrouter.ai/api/v1
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="https://api.together.xyz/v1"
# LLM_BASE_URL="http://localhost:11434/v1"   # Ollama

# ── Model ───────────────────────────────────────────────────────────────────
# Use the provider's model identifier. OpenRouter's "provider/model"
# form works through the default base URL.
MODEL="google/gemini-3-flash-preview"
# Local fallback (no API key required, returns gibberish):
# MODEL="local-gibberish"

# ── Text-to-speech (optional) ───────────────────────────────────────────────
# TTS_ENABLED=TRUE
# TTS_MODEL="google/gemini-3.1-flash-tts-preview"

# ── Auth + storage (optional GCP services; LLM/TTS no longer use GCP) ──────
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# AUTH_BACKEND="firebase"          # or "none" for local dev
# STORAGE_BACKEND="memory"         # or "firestore"
# FIRESTORE_DATABASE="(default)"
# FIRESTORE_COLLECTION="debates"

# ── Optional server overrides ───────────────────────────────────────────────
# PORT="8000"
# DATA_DIR="./agents"
